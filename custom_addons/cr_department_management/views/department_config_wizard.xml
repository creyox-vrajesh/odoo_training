<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- form view -->
    <record id='department_conf_view_form' model='ir.ui.view'>
        <field name='name'>department.conf.form</field>
        <field name='model'>department.conf</field>
        <field name='arch' type='xml'>
            <form string="Department Configuration">
                
                <sheet>
                    <group>

                        <field name='type'/>
                        <field name='name'/>
                        <field name='code'/>
                        <field name='department_id' 
                        invisible="type != 'write'"
                        required="type == 'write'"/>
                    </group>
                </sheet>
                
                <footer>                    
                    <button name="action_process"
                        string="Process"
                        type="object"
                    />

                    <button string="Cancel"
                        type="object"
                        special="cancel"
                    />

                </footer>
            </form>
        </field>
    </record>

    <record id='department_conf_action' model='ir.actions.act_window'>
        <field name='name'>Deparmtent</field>
        <field name='res_model'>department.conf</field>
        <field name='view_mode'>form</field>
        <field name='target'>new</field>
    </record>

    <!-- menus -->
    <menuitem
        id='department_configuration_menu'
        parent='department_management_menu_root'
        name='Configuration'
    />
    <menuitem
        id='department_conf_menu'
        parent='department_configuration_menu'
        name='Department Configuration'
        action='department_conf_action'
    />
</odoo>