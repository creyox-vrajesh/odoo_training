<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- list view -->
    <record id='employee_employee_view_list' model='ir.ui.view'>
        <field name='name'>employee.employee.list</field>
        <field name='model'>employee.employee</field>
        <field name='arch' type='xml'>
            <list>
                <field name='name' />
                <field name='image' />
                <field name='street' />
                <field name='city' />
                <field name='zip' />
                <field name='state_id' />
                <field name='country_id' />
                <field name='birthdate' />
                <field name='age' />
                <field name='mobile' />
                <field name='email' />
                <field name='barcode' />
                <field name='job_time' />
                <field name='notes' />
                <field name='remarks' />
                <field name='is_hod' />
                <field name='active' />
            </list>
        </field>
    </record>

    <!-- form view  -->
    <record id='employee_employee_view_form' model='ir.ui.view'>
        <field name='name'>employee.employee.form</field>
        <field name='model'>employee.employee</field>
        <field name='arch' type='xml'>
            <form string="Employee">
                <sheet>
                    <field name='image' widget='image' class='oe_avatar' />

                    <div class="oe_title">
                        <field name='name' placeholder="Employee Full Name" required="1" />
                    </div>

                    <group>
                        <!-- Column 1  -->
                        <group string='Contact &amp; Personal Info'>
                            <field name='mobile' widget="phone" />
                            <field name='email' widget="email" />
                            <field name='birthdate' />
                            <field name='age' />
                        </group>

                        <!-- Column 2  -->

                        <group string='HR Information'>
                            <field name='job_time' />
                            <field name='barcode' />
                            <field name='is_hod' widget="boolean_toggle" />
                            <field name='active' widget="boolean_toggle" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Address Info">
                            <group>
                                <label for="street" string="Address"/>
                                <div>
                                    <field name="street" placeholder="Street..." />
                                    <field name="city" placeholder="City" />
                                    <field name="state_id" placeholder="State"  />
                                    <field name="zip" placeholder="ZIP" />
                                    <field name="country_id" placeholder="Country"/>
                                </div>
                            </group>
                        </page>
                        <page string="Notes &amp; Remarks">
                            <group>
                                <field name='notes' placeholder="Add internal notes : "/>
                                <field name='remarks' placeholder="Add remarks : "/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- kanban view -->
    <record id='employee_employee_view_kanban' model='ir.ui.view'>
        <field name="name">employee.employee.kanban</field>
        <field name="model">employee.employee</field>
        <field name='arch' type='xml'>
            <kanban>
                <field name="id" />
                <field name="name" />
                <field name="email" />
                <field name="mobile" />
                <field name="image" />

                <templates>
                    <t t-name='card'>
                        <div class="d-flex align-items-start gap-3 w-100">
                            <!-- Left -->
                            <div class="flex-shrink-0">
                                <field name="image" widget="image"
                                    options="{'preview_image': 'image', 'size': [60, 80]}"
                                    class="rounded bg-view" />
                            </div>
                            <!-- Right -->
                            <div class="flex-grow-1 min-w-0 d-flex flex-column gap-1">
                                <div class="fw-bold text-truncate text-900 fs-5 mb-1">
                                    <field name="name" />
                                </div>
                                <div class="text-muted small text-truncate">
                                    <i class="fa fa-envelope me-1" />
                                    <field name="email" />
                                </div>
                                <div class="text-muted small text-truncate">
                                    <i class="fa fa-phone me-1" />
                                    <field name="mobile" />
                                </div>
                                <div class="mt-1">
                                    <span class="badge bg-secondary rounded-pill">
                                        <field name="job_time" />
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- activity view -->
    <record id="employee_employee_view_activity" model="ir.ui.view">
        <field name="name">employee.employee.activity</field>
        <field name="model">employee.employee</field>
        <field name="arch" type="xml">
            <activity string='Employee Activites'>
                <field name='name'/>
                <templates>
                    <div t-name='activity-box'>
                        <div>                            
                            <field name="name" display='full'/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <!-- action -->
    <record id='employee_employee_action' model='ir.actions.act_window'>
        <field name='name'>Employees</field>
        <field name='res_model'>employee.employee</field>
        <field name='view_mode'>list,form,kanban,activity</field>
    </record>

    <!-- menu -->
    <menuitem
        id='employee_employee_menu'
        parent='department_management_menu_root'
        name='Employees'
        action='employee_employee_action'

    />

</odoo>
                