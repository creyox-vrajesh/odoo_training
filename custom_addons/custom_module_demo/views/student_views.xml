<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- list view -->
    <record id="school_student_view_list" model="ir.ui.view">
        <field name="name">school.student.list</field>
        <field name="model">school.student</field>

        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="age" />
                <field name="email" />
                <field name="teacher_id" />
            </list>
        </field>
    </record>

    <record id="school_student_view_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form>
                <field name="name" />
                <field name="age" />
                <field name="email" />
                <field name="teacher_id" />
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="school_student_action" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="school_student_root"
        name="Students"
    />
    <menuitem
        id="school_student_menu"
        parent="school_student_root"
        name="Students"
        action="school_student_action"
    />
</odoo>